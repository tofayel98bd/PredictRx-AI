# ================================================================
# PredictRx-AI (PredictRx BD) — Unified Environment Configuration
# ================================================================

# --- Frontend Configuration (React / Vite) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_ENABLE_MOCK_FALLBACK=true
VITE_MOCK_LATENCY_MS=1200

# --- Backend Application Configuration (FastAPI) ---
PROJECT_NAME="PredictRx-AI (PredictRx BD)"
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change_this_to_a_secure_random_secret_in_production_2026_xyz
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS Allowed Origins ---
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:8000"]

# --- Database Configuration (PostgreSQL 16 Alpine Isolated Container) ---
# NOTE: Host port is 5434 to avoid conflicts with local Postgres (5432) or needs-postgres (5433)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5434
POSTGRES_USER=predictrx_user
POSTGRES_PASSWORD=predictrx_password_dev
POSTGRES_DB=predictrx_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
