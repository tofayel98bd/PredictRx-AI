# ==============================================================================
# PredictRx-AI — Production Git Ignore Specification
# ==============================================================================

# --- Environment & Sensitive Secret Files ---
.env
.env.*
*.env
!*.env.example
!.env.example
secrets/
*.pem
*.key
*.cert

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Testing & Quality Assurance ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# --- Node / Frontend Artifacts ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
frontend/dist/
frontend/build/
.vite/

# --- Databases & Local Storage ---
*.sqlite
*.sqlite3
*.db
*.db-journal
*.log
database/*.sqlite*
database/*.db*

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- IDEs & Code Editors ---
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- Temporary & Internal Scratch Files ---
tmp/
temp/
reports/
PREDICTRX_*.md
*.tmp
*.bak
DEMO_SCRIPT.md
docs/DEMO_SCRIPT.md
