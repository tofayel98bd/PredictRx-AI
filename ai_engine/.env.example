# ==============================================================================
# PredictRx-AI — AI Engine (Layer 1 Vision OCR) Environment Configuration
# ==============================================================================

# LLM Provider: 'gemini' or 'anthropic'
LLM_PROVIDER=gemini

# Google Gemini API Configuration (Default for Multimodal Vision OCR)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Anthropic Claude API Configuration (Optional alternative provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5-5
